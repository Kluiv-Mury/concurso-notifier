# Token do bot, obtido com o @BotFather no Telegram.
TELEGRAM_TOKEN=coloque-seu-token-aqui

# Seu chat_id no Telegram, para receber aviso quando o scraping quebrar.
# Descubra o seu mandando /start para o @userinfobot.
# ADMIN_CHAT_ID=

# Chave Fernet que cifra o nome do usuário no banco. Sem ela, o nome
# simplesmente não é guardado. Gere a sua com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Se perder a chave, os nomes já gravados ficam ilegíveis (não é crítico).
# NOME_KEY=

# Opcionais — valores em minutos.
# INTERVALO_SCRAPING_MIN=61
# INTERVALO_ALERTAS_MIN=17
# INTERVALO_BACKUP_MIN=1440
# INTERVALO_LEMBRETES_MIN=720
# LOG_LEVEL=INFO

# Fuso usado para decidir se a inscrição ainda está aberta.
# TIMEZONE=America/Sao_Paulo
