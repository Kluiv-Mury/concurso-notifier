# Token do bot, obtido com o @BotFather no Telegram.
TELEGRAM_TOKEN=coloque-seu-token-aqui

# Seu chat_id no Telegram, para receber aviso quando o scraping quebrar.
# Descubra o seu mandando /start para o @userinfobot.
# ADMIN_CHAT_ID=

# Opcionais — valores em minutos.
# INTERVALO_SCRAPING_MIN=61
# INTERVALO_ALERTAS_MIN=17
# INTERVALO_BACKUP_MIN=1440
# LOG_LEVEL=INFO
